+/*
+ * Maps Java exception types to the appropriate Python exception type.
+ * 
+ * @param env       the JNI environment
+ * @param exception the Java throwable
+ * @param clazz     the jclass for the throwable
+ *
+ * @return the appropriate Python exception type
+ */
+static PyObject* get_pyexception_type(JNIEnv *env, jthrowable exception, jclass clazz) {
+    jstring className = NULL;
+    const char *classNameStr = NULL;
+    PyObject *pyExcType = PyExc_RuntimeError;
+    jclass langClass = NULL;
+    
+    // get the Class object for java.lang.Class to find getName method
+    if(classGetName == 0) {
+        langClass = (*env)->FindClass(env, "java/lang/Class");
+        if(!langClass || (*env)->ExceptionCheck(env)) {
+            return PyExc_RuntimeError;
+        }
+        classGetName = (*env)->GetMethodID(env, langClass, "getName", "()Ljava/lang/String;");
+        if(!classGetName || (*env)->ExceptionCheck(env)) {
+            return PyExc_RuntimeError;
+        }
+    }
+    
+    // get the class name of the exception
+    className = (jstring) (*env)->CallObjectMethod(env, clazz, classGetName);
+    if(!className || (*env)->ExceptionCheck(env)) {
+        return PyExc_RuntimeError;
+    }
+    
+    classNameStr = (*env)->GetStringUTFChars(env, className, 0);
+    if(!classNameStr) {
+        (*env)->ReleaseStringUTFChars(env, className, classNameStr);
+        (*env)->DeleteLocalRef(env, className);
+        return PyExc_RuntimeError;
+    }
+    
+    // map common Java exceptions to Python exceptions
+    // using strcmp on the fully qualified class name
+    if(strcmp(classNameStr, "java.lang.NumberFormatException") == 0) {
+        pyExcType = PyExc_ValueError;
+    }
+    else if(strcmp(classNameStr, "java.lang.IllegalArgumentException") == 0) {
+        pyExcType = PyExc_ValueError;
+    }
+    else if(strcmp(classNameStr, "java.lang.IllegalStateException") == 0) {
+        pyExcType = PyExc_RuntimeError;
+    }
+    else if(strcmp(classNameStr, "java.lang.NullPointerException") == 0) {
+        pyExcType = PyExc_AttributeError;
+    }
+    else if(strcmp(classNameStr, "java.lang.IndexOutOfBoundsException") == 0) {
+        pyExcType = PyExc_IndexError;
+    }
+    else if(strcmp(classNameStr, "java.lang.ArrayIndexOutOfBoundsException") == 0) {
+        pyExcType = PyExc_IndexError;
+    }
+    else if(strcmp(classNameStr, "java.lang.StringIndexOutOfBoundsException") == 0) {
+        pyExcType = PyExc_IndexError;
+    }
+    else if(strcmp(classNameStr, "java.lang.ArrayStoreException") == 0) {
+        pyExcType = PyExc_TypeError;
+    }
+    else if(strcmp(classNameStr, "java.lang.ClassCastException") == 0) {
+        pyExcType = PyExc_TypeError;
+    }
+    else if(strcmp(classNameStr, "java.lang.UnsupportedOperationException") == 0) {
+        pyExcType = PyExc_NotImplementedError;
+    }
+    else if(strcmp(classNameStr, "java.lang.ArithmeticException") == 0) {
+        pyExcType = PyExc_ZeroDivisionError;
+    }
+    else if(strcmp(classNameStr, "java.lang.OutOfMemoryError") == 0) {
+        pyExcType = PyExc_MemoryError;
+    }
+    else if(strcmp(classNameStr, "java.io.IOException") == 0) {
+        pyExcType = PyExc_IOError;
+    }
+    else if(strcmp(classNameStr, "java.io.FileNotFoundException") == 0) {
+        pyExcType = PyExc_IOError;
+    }
+    else if(strcmp(classNameStr, "java.io.EOFException") == 0) {
+        pyExcType = PyExc_EOFError;
+    }
+    else if(strcmp(classNameStr, "java.lang.NoSuchMethodException") == 0) {
+        pyExcType = PyExc_AttributeError;
+    }
+    else if(strcmp(classNameStr, "java.lang.NoSuchFieldException") == 0) {
+        pyExcType = PyExc_AttributeError;
+    }
+    // Check for ImportError-related exceptions
+    else if(strcmp(classNameStr, "java.lang.ClassNotFoundException") == 0) {
+        pyExcType = PyExc_ImportError;
+    }
+    else if(strcmp(classNameStr, "java.lang.NoClassDefFoundError") == 0) {
+        pyExcType = PyExc_ImportError;
+    }
+    
+    (*env)->ReleaseStringUTFChars(env, className, classNameStr);
+    (*env)->DeleteLocalRef(env, className);
+    
+    return pyExcType;
+}
