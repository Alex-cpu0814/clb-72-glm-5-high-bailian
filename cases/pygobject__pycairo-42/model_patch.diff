 };
 #endif
 
+#if PY_MAJOR_VERSION >= 3
+static int
+image_surface_getbuffer (PyObject *obj, Py_buffer *view, int flags) {
+  PycairoImageSurface *o = (PycairoImageSurface *)obj;
+  cairo_surface_t *surface = o->surface;
+  unsigned char *buffer;
+  int height, stride;
+  Py_ssize_t size;
+
+  buffer = cairo_image_surface_get_data (surface);
+  if (buffer == NULL) {
+    PyErr_SetString(PyExc_ValueError, "surface has no data");
+    return -1;
+  }
+  height = cairo_image_surface_get_height (surface);
+  stride = cairo_image_surface_get_stride (surface);
+  size = (Py_ssize_t)height * stride;
+
+  return PyBuffer_FillInfo(view, obj, buffer, size, 0, flags);
+}
+
+static void
+image_surface_releasebuffer (PyObject *obj, Py_buffer *view) {
+  /* Nothing to do since we don't export any additional info */
+}
+
+static PyBufferProcs image_surface_as_buffer = {
+  image_surface_getbuffer,
+  image_surface_releasebuffer,
+};
+#endif
