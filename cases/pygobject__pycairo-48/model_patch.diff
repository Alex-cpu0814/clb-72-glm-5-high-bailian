+/* Class RasterSourcePattern ---------------------------------------------- */
+
+typedef struct {
+    PyObject *acquire_callback;
+    PyObject *release_callback;
+    PyObject *snapshot_callback;
+    PyObject *copy_callback;
+    PyObject *finish_callback;
+} RasterSourceCallbacks;
+
+static void
+_raster_source_destroy_callback_data (void *callback_data) {
+  PyGILState_STATE gstate = PyGILState_Ensure();
+  RasterSourceCallbacks *callbacks = (RasterSourceCallbacks *)callback_data;
+  
+  Py_CLEAR(callbacks->acquire_callback);
+  Py_CLEAR(callbacks->release_callback);
+  Py_CLEAR(callbacks->snapshot_callback);
+  Py_CLEAR(callbacks->copy_callback);
+  Py_CLEAR(callbacks->finish_callback);
+  PyMem_Free(callbacks);
+  
+  PyGILState_Release(gstate);
+}
+
+static const cairo_user_data_key_t raster_source_callbacks_key;
+
+static cairo_surface_t *
+_raster_source_acquire_callback (cairo_pattern_t *pattern,
+                                 void *callback_data,
+                                 cairo_surface_t *target,
+                                 const cairo_rectangle_int_t *extents) {
+  RasterSourceCallbacks *callbacks = (RasterSourceCallbacks *)callback_data;
+  PyGILState_STATE gstate;
+  PyObject *result = NULL;
+  PyObject *args = NULL;
+  cairo_surface_t *surface = NULL;
+  
+  if (callbacks->acquire_callback == NULL)
+    return NULL;
+    
+  gstate = PyGILState_Ensure();
+  
+  args = Py_BuildValue("(iiii)",
+                       extents->x, extents->y,
+                       extents->width, extents->height);
+  if (args == NULL)
+    goto done;
+  
+  result = PyObject_CallObject(callbacks->acquire_callback, args);
+  if (result == NULL) {
+    if (PyErr_Occurred())
+      PyErr_Print();
+    goto done;
+  }
+  
+  if (result == Py_None) {
+    /* Return NULL to indicate no surface available */
+    surface = NULL;
+  } else if (PyObject_TypeCheck(result, &PycairoSurface_Type)) {
+    surface = cairo_surface_reference(((PycairoSurface *)result)->surface);
+  } else {
+    PyErr_SetString(PyExc_TypeError,
+                    "acquire callback should return a Surface or None");
+    PyErr_Print();
+    surface = NULL;
+  }
+  
+done:
+  Py_XDECREF(result);
+  Py_XDECREF(args);
+  PyGILState_Release(gstate);
+  return surface;
+}
+
+static void
+_raster_source_release_callback (cairo_pattern_t *pattern,
+                                 void *callback_data,
+                                 cairo_surface_t *surface) {
+  RasterSourceCallbacks *callbacks = (RasterSourceCallbacks *)callback_data;
+  PyGILState_STATE gstate;
+  PyObject *result = NULL;
+  PyObject *py_surface = NULL;
+  
+  if (callbacks->release_callback == NULL) {
+    cairo_surface_destroy(surface);
+    return;
+  }
+  
+  gstate = PyGILState_Ensure();
+  
+  py_surface = PycairoSurface_FromSurface(
+    cairo_surface_reference(surface), NULL);
+  if (py_surface == NULL) {
+    if (PyErr_Occurred())
+      PyErr_Print();
+    goto done;
+  }
+  
+  result = PyObject_CallFunctionObjArgs(callbacks->release_callback,
+                                        py_surface, NULL);
+  if (result == NULL) {
+    if (PyErr_Occurred())
+      PyErr_Print();
+  }
+  
+done:
+  cairo_surface_destroy(surface);
+  Py_XDECREF(result);
+  Py_XDECREF(py_surface);
+  PyGILState_Release(gstate);
+}
+
+static cairo_status_t
+_raster_source_snapshot_callback (cairo_pattern_t *pattern,
+                                  void *callback_data) {
+  RasterSourceCallbacks *callbacks = (RasterSourceCallbacks *)callback_data;
+  PyGILState_STATE gstate;
+  PyObject *result = NULL;
+  cairo_status_t status = CAIRO_STATUS_SUCCESS;
+  
+  if (callbacks->snapshot_callback == NULL)
+    return CAIRO_STATUS_SUCCESS;
+  
+  gstate = PyGILState_Ensure();
+  
+  result = PyObject_CallObject(callbacks->snapshot_callback, NULL);
+  if (result == NULL) {
+    if (PyErr_Occurred())
+      PyErr_Print();
+    status = CAIRO_STATUS_USER_FONT_ERROR;
+  }
+  
+  Py_XDECREF(result);
+  PyGILState_Release(gstate);
+  return status;
+}
+
