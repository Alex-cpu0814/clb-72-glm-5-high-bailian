+  RasterSourceCallbacks *callbacks = (RasterSourceCallbacks *)callback_data;
+  PyGILState_STATE gstate;
+  PyObject *result = NULL;
+  
+  if (callbacks->finish_callback == NULL)
+    return;
+  
+  gstate = PyGILState_Ensure();
+  
+  result = PyObject_CallObject(callbacks->finish_callback, NULL);
+  if (result == NULL) {
+    if (PyErr_Occurred())
+      PyErr_Print();
+  }
+  
+  Py_XDECREF(result);
+  PyGILState_Release(gstate);
+}
+
+static PyObject *
+raster_source_pattern_new (PyTypeObject *type, PyObject *args, PyObject *kwds) {
+  int content, width, height;
+  cairo_pattern_t *pattern;
+  RasterSourceCallbacks *callbacks;
+  
+  if (!PyArg_ParseTuple(args, "iii:RasterSourcePattern.__new__",
+                        &content, &width, &height))
+    return NULL;
+  
+  callbacks = PyMem_Malloc(sizeof(RasterSourceCallbacks));
+  if (callbacks == NULL) {
+    PyErr_NoMemory();
+    return NULL;
+  }
+  
+  callbacks->acquire_callback = NULL;
+  callbacks->release_callback = NULL;
+  callbacks->snapshot_callback = NULL;
+  callbacks->copy_callback = NULL;
+  callbacks->finish_callback = NULL;
+  
+  pattern = cairo_pattern_create_raster_source(callbacks, content, width, height);
+  if (cairo_pattern_status(pattern) != CAIRO_STATUS_SUCCESS) {
+    PyMem_Free(callbacks);
+    return PycairoPattern_FromPattern(pattern, NULL);
+  }
+  
+  /* Set user data to track the callbacks lifetime */
+  cairo_status_t status = cairo_pattern_set_user_data(
+    pattern, &raster_source_callbacks_key, callbacks,
+    _raster_source_destroy_callback_data);
+  
+  if (status != CAIRO_STATUS_SUCCESS) {
+    cairo_pattern_destroy(pattern);
+    PyMem_Free(callbacks);
+    Pycairo_Check_Status(status);
+    return NULL;
+  }
+  
+  return PycairoPattern_FromPattern(pattern, NULL);
+}
+
+static PyObject *
+raster_source_pattern_set_acquire (PycairoPattern *obj, PyObject *args) {
+  PyObject *acquire, *release;
+  RasterSourceCallbacks *callbacks;
+  
+  if (!PyArg_ParseTuple(args, "OO:RasterSourcePattern.set_acquire",
+                        &acquire, &release))
+    return NULL;
+  
+  if (acquire != Py_None && !PyCallable_Check(acquire)) {
+    PyErr_SetString(PyExc_TypeError, "acquire must be callable or None");
+    return NULL;
+  }
+  
+  if (release != Py_None && !PyCallable_Check(release)) {
+    PyErr_SetString(PyExc_TypeError, "release must be callable or None");
+    return NULL;
+  }
+  
+  callbacks = cairo_raster_source_pattern_get_callback_data(obj->pattern);
+  if (callbacks == NULL) {
+    PyErr_SetString(PyExc_RuntimeError, "No callback data");
+    return NULL;
+  }
+  
+  Py_CLEAR(callbacks->acquire_callback);
+  Py_CLEAR(callbacks->release_callback);
+  
+  if (acquire != Py_None) {
+    callbacks->acquire_callback = acquire;
+    Py_INCREF(acquire);
+  }
+  
+  if (release != Py_None) {
+    callbacks->release_callback = release;
+    Py_INCREF(release);
+  }
+  
+  cairo_raster_source_pattern_set_acquire(obj->pattern,
+                                          _raster_source_acquire_callback,
+                                          _raster_source_release_callback);
+  
+  Py_RETURN_NONE;
+}
+
+static PyObject *
+raster_source_pattern_get_acquire (PycairoPattern *obj) {
+  RasterSourceCallbacks *callbacks;
+  PyObject *acquire, *release;
+  
+  callbacks = cairo_raster_source_pattern_get_callback_data(obj->pattern);
+  if (callbacks == NULL) {
+    PyErr_SetString(PyExc_RuntimeError, "No callback data");
+    return NULL;
+  }
+  
+  acquire = callbacks->acquire_callback ? callbacks->acquire_callback : Py_None;
+  release = callbacks->release_callback ? callbacks->release_callback : Py_None;
+  
+  Py_INCREF(acquire);
+  Py_INCREF(release);
+  return Py_BuildValue("(OO)", acquire, release);
+}
