+static PyObject *
+pysqlite_connection_limit(pysqlite_Connection* self, PyObject* args)
+{
+    int id;
+    int value = -1;
+    int old_value;
+
+    if (!pysqlite_check_thread(self) || !pysqlite_check_connection(self)) {
+        return NULL;
+    }
+
+    if (!PyArg_ParseTuple(args, "i|i", &id, &value)) {
+        return NULL;
+    }
+
+    old_value = sqlite3_limit(self->db, id, value);
+
+    return PyInt_FromLong(old_value);
+}
+
