-JPy_JMethod* JOverloadedMethod_FindMethod0(JNIEnv* jenv, JPy_JOverloadedMethod* overloadedMethod, PyObject* pyArgs, JPy_MethodFindResult* result)
+/**
+ * Returns true if all methods in the overloaded method list are static.
+ */
+static jboolean JOverloadedMethod_AreAllMethodsStatic(JPy_JOverloadedMethod* overloadedMethod)
+{
+    int overloadCount;
+    int i;
+    
+    overloadCount = PyList_Size(overloadedMethod->methodList);
+    for (i = 0; i < overloadCount; i++) {
+        JPy_JMethod* method = (JPy_JMethod*) PyList_GetItem(overloadedMethod->methodList, i);
+        if (!method->isStatic) {
+            return JNI_FALSE;
+        }
+    }
+    return JNI_TRUE;
+}
+
